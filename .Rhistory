"data/PZ011000.1.fasta"  # UK
)
# Nombres de los países para que aparezcan en el árbol
nombres_paises <- c("USA", "China", "India", "Francia", "Alemania",
"Brazil", "CoreaDelSur", "Japon", "Italia", "UK")
# 2. Cargar secuencias
dna_ss <- readDNAStringSet(files)
names(dna_ss) <- nombres_paises
# 3. Análisis de k-mers (Tetranucleótidos = 4)
# Esto calcula la frecuencia de combinaciones de 4 letras en cada genoma
prob_kmers <- oligonucleotideFrequency(dna_ss, width = 4, as.prob = TRUE)
# 4. Calcular matriz de distancia euclidiana
dist_matrix <- dist(prob_kmers)
# 5. Generar el Clúster Jerárquico (hclust)
hc <- hclust(dist_matrix, method = "complete")
# 6. Graficar para que se vea como tu imagen
# Ajustamos márgenes para que no se corten los nombres
par(mar=c(5, 5, 4, 2))
plot(as.dendrogram(hc),
main = "Análisis Jerárquico Global de Variantes de SARS-CoV-2",
ylab = "Distancia Genética",
xlab = "País",
sub = "Basado en frecuencias de tetranucleótidos (k-mers)",
edgePar = list(col = "black", lwd = 2))
